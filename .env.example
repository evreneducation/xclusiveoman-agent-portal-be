# Server
PORT=4000
NODE_ENV=development

# scripts/seed.js's default super_admin account. Dev: a real inbox so OTP
# emails during local testing are actually receivable, e.g.
# shreysrivastava573@gmail.com. Prod: the real inbox that will run the seed
# there, e.g. xclusiveoman@gmail.com.
SEED_ADMIN_EMAIL=

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/xclusiveoman

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins allowed to send credentialed requests)
# 5173 = agent portal dev server, 5174 = admin portal dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL used to build links in emails (e.g. password reset)
AGENT_PORTAL_URL=http://localhost:5173/agent

# Brevo (formerly Sendinblue) transactional email API - sends every email
# this app sends (OTP, registration/approval, staff welcome, Marketing
# Center, payment confirmations, support tickets, FD operations, ...).
# SMTP/Nodemailer was removed - it isn't usable on Render for outbound mail.
# Optional in dev; if unset, emails are logged to console instead.
# BREVO_SENDER_EMAIL must be a sender verified in Brevo's own dashboard, or
# sends are rejected regardless of API key validity.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Xclusive Oman"

# Used for FGD Enquire Now WhatsApp deep links (e.g. 96891234567, no + or spaces)
WHATSAPP_SALES_NUMBER=

# Cloudinary (file uploads) - optional in dev; upload endpoints return 503 until set
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cashfree (payments) - optional in dev; payment endpoints return 503 until set
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_BASE_URL=https://sandbox.cashfree.com/pg
